        "html": "=\n<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n\n<body style=\"margin:0;padding:0;background-color:#F4F7F4;font-family:Arial,Tahoma,sans-serif;direction:rtl;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#F4F7F4;\">\n  <tr>\n    <td align=\"center\" style=\"padding:35px 12px;\">\n\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n             style=\"max-width:600px;background:#FFFFFF;border-radius:16px;overflow:hidden;\">\n\n        <!-- Header -->\n        <tr>\n          <td align=\"center\" style=\"padding:23px;background:#105548;\">\n            <h1 style=\"margin:0;color:#FFFFFF;font-size:25px;\">\n              تقرير إنجازك الأسبوعي\n            </h1>\n            <p style=\"margin:12px 0 0;color:#E2C78B;font-size:14px;\">\n              {{ $json.weekStart }} — {{ $json.weekEnd }}\n            </p>\n          </td>\n        </tr>\n\n        <!-- Welcome -->\n        <tr>\n          <td style=\"padding:30px 30px 15px;text-align:right;\">\n            <h2 style=\"color:#105548;font-size:21px;margin:0 0 12px;\">\n              أهلًا {{ $json.name }} 👋\n            </h2>\n            <p style=\"color:#606D67;font-size:15px;line-height:1.9;margin:0;\">\n              أسبوع جديد من رحلتك نحو تحقيق أهدافك.\n              إليك ملخص أدائك وإنجازاتك خلال الأسبوع الماضي.\n            </p>\n          </td>\n        </tr>\n\n        <!-- Completion percentage -->\n        <tr>\n          <td style=\"padding:15px 30px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n                   style=\"background:#F1F7F3;border-radius:12px;\">\n              <tr>\n                <td align=\"center\" style=\"padding:28px 18px;\">\n\n                  <p style=\"color:#526C60;font-size:15px;margin:0;\">\n                    نسبة إنجازك\n                  </p>\n\n                  <h1 style=\"color:#105548;font-size:52px;margin:12px 0;font-weight:bold;\">\n                    {{ $json.completionPercentage }}%\n                  </h1>\n\n                  <div style=\"background:#D8E7DE;height:12px;border-radius:8px;overflow:hidden;text-align:left;\">\n                    <div style=\"background:#C5A25C;height:12px;border-radius:8px;width:{{ $json.completionPercentage }}%;\"></div>\n                  </div>\n\n                  <p style=\"color:#5F7467;font-size:13px;margin:14px 0 0;\">\n                    كل خطوة تنجزها تقرّبك أكثر من هدفك\n                  </p>\n\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- Statistics -->\n        <tr>\n          <td style=\"padding:18px 30px;\">\n            <table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\">\n              <tr>\n                <td align=\"center\" width=\"33%\">\n                  <h2 style=\"margin:0;color:#105548;font-size:28px;\">\n                    {{ $json.required }}\n                  </h2>\n                  <p style=\"color:#69746E;font-size:13px;\">المطلوب</p>\n                </td>\n\n                <td align=\"center\" width=\"33%\">\n                  <h2 style=\"margin:0;color:#105548;font-size:28px;\">\n                    {{ $json.completed }}\n                  </h2>\n                  <p style=\"color:#69746E;font-size:13px;\">المنجز</p>\n                </td>\n\n                <td align=\"center\" width=\"33%\">\n                  <h2 style=\"margin:0;color:#BF9851;font-size:28px;\">\n                    {{ $json.excused }}\n                  </h2>\n                  <p style=\"color:#69746E;font-size:13px;\">الأعذار</p>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- AI Analysis -->\n        <tr>\n          <td style=\"padding:12px 30px 25px;text-align:right;\">\n\n            <div style=\"border-top:1px solid #E6ECE7;margin-bottom:25px;\"></div>\n\n            <h3 style=\"color:#105548;font-size:19px;margin:0 0 16px;\">\n              تحليل أدائك وتوصياتك\n            </h3>\n\n            <div style=\"background:#FBF9F3;padding:22px;border-radius:8px;\">\n              <p style=\"margin:0;color:#34483D;font-size:15px;line-height:2;white-space:pre-line;\">\n                {{ $json.aiAnalysis }}\n              </p>\n            </div>\n\n          </td>\n        </tr>\n\n        <!-- Motivational message -->\n        <tr>\n          <td align=\"center\" style=\"padding:15px 30px 30px;\">\n            <p style=\"font-size:16px;color:#B28C45;margin:0;font-weight:bold;\">\n              التزامك اليوم يصنع نجاحك غدًا.\n            </p>\n          </td>\n        </tr>\n\n        <!-- Footer -->\n        <tr>\n          <td align=\"center\" style=\"background:#105548;padding:24px;\">\n            <p style=\"color:#FFFFFF;font-size:15px;margin:0;font-weight:bold;\">\n              أتعهد\n            </p>\n            <p style=\"color:#D9E8DD;font-size:12px;margin:10px 0 0;\">\n              رحلتك نحو الالتزام تبدأ بخطوة\n            </p>\n            <p style=\"color:#D9E8DD;font-size:11px;margin:14px 0 0;\">\n              هذه رسالة تلقائية من منصة أتعهد\n            </p>\n          </td>\n        </tr>\n\n      </table>\n\n    </td>\n  </tr>\n</table>\n\n</body>\n</html>\n",
