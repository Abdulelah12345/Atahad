    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- LOCAL TEST ONLY (not committed): the backend on the PC is plain http://10.0.2.2:8080 -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
